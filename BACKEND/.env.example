# Copier ce fichier en BACKEND/.env puis remplir les clés (ne jamais publier le vrai .env)
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# Embeddings (changer l'un des deux impose de réindexer avec --rebuild)
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# Offre gratuite Gemini : rester sous ~100 textes par minute
EMBED_BATCH_SIZE=50
EMBED_PAUSE_S=35
